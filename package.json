{
  "name": "petex",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop pets for macOS and Windows.",
  "main": "app/main.cjs",
  "author": "Petex contributors",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node -e \"require('electron')\" && playwright test",
    "check": "node --check app/main.cjs && node --check app/library.cjs && node --check app/preload.cjs && node --check app/renderer/settings.js && node --check app/renderer/pet.js && npm test",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "icons": "node scripts/icons.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "test:packaged": "node scripts/test-package.cjs",
    "dist:mas": "electron-builder --mac mas --arm64 --publish never",
    "version:ci": "node scripts/version.cjs",
    "build:native": "node scripts/build-native.cjs",
    "prestart": "npm run build:native",
    "predev": "npm run build:native",
    "pretest:desktop": "npm run build:native"
  },
  "build": {
    "appId": "app.pedex.desktop",
    "productName": "Petex",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "README.md",
      "PRIVACY.md"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "appId": "ad.neko.petex"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "app/native/**/*"
    ],
    "beforePack": "scripts/before-pack.cjs",
    "mas": {
      "appId": "ad.neko.petex",
      "identity": "Kitta Ltd (7P8CLHDH5G)",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "artifactName": "Petex-${version}-mas-${arch}.${ext}",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.entertainment"
      },
      "sign": "scripts/sign-mas.cjs"
    },
    "electronLanguages": [
      "en-GB",
      "en-US",
      "zh-CN",
      "zh-TW",
      "ja",
      "es",
      "fr"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iebb/petex.git"
  }
}
